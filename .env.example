# ───────── Servidor ─────────
PORT=8787
# Pon DEMO=1 para ver el dashboard con datos falsos (sin configurar nada)
DEMO=0

# ───────── Tu juego ─────────
GAME_NAME=Game Of Life
# El universeId NO es el placeId. Si solo sabes el placeId, deja UNIVERSE_ID vacio
# y pon PLACE_ID: el servidor lo resuelve solo.
UNIVERSE_ID=
PLACE_ID=80633510292098

# ───────── Meta ─────────
GOAL_ROBUX=300000
# Desde que fecha cuenta la meta (YYYY-MM-DD). Vacio = todo lo registrado.
GOAL_START=

# ───────── Ingesta en vivo desde el juego (recomendado) ─────────
# Clave compartida con el Script de Roblox (roblox-script/). Invéntate una larga.
INGEST_SECRET=

# ───────── Economy API (ventas / Robux reales) ─────────
# Cookie .ROBLOSECURITY de la cuenta dueña del juego. SOLO local, nunca la subas.
ROBLOSECURITY=
# Si el juego es de tu cuenta personal:
ROBLOX_USER_ID=
# Si el juego pertenece a un grupo (usa esto en vez del user):
ROBLOX_GROUP_ID=

# ───────── Open Cloud (opcional, metricas oficiales) ─────────
OPENCLOUD_API_KEY=

# ───────── Tiempos ─────────
POLL_PUBLIC_SEC=60
POLL_ECONOMY_SEC=120
